# perf/.env 로 복사해서 채워요 (perf/.env는 커밋되지 않아요)

BASE_URL=http://3.37.131.73          # k6가 부르는 곳. Vercel을 거치지 않고 EC2 nginx로 바로
EC2_HOST=3.37.131.73
SSH_USER=ubuntu
SSH_KEY=~/.ssh/mujuthaek-prod.pem

# CloudWatch 그래프·숫자 저장용 (aws cli 로그인이 돼 있어야 해요. 비우면 그 단계만 건너뛰어요)
AWS_REGION=ap-northeast-2
AWS_PROFILE=
EC2_INSTANCE_ID=                     # i-…
RDS_INSTANCE_ID=                     # RDS 식별자

# 로그인 사용자 흐름(15%). 둘 다 비우면 그 몫은 판정 흐름으로 돌려요 (meta.json에 남아요)
JWT_SECRET=                          # 운영 JWT_SECRET. 여기 말고 어디에도 적지 않아요
TEST_USER_ID=                        # 테스트 계정 회원 id (UUID)

# 더미 데이터(perf/seed)와 dev 테스트. README 「세 단계」
DEV_EC2_HOST=                        # dev 서버 (52.79.106.144). 비우면 dev 대상은 거부해요
DEV_JWT_SECRET=                      # dev 서버 JWT_SECRET. 더미 회원 토큰(k6/make-tokens.sh dev)에만 써요
LOCAL_DB_NAME=api_fe                 # 로컬 api가 쓰는 DB (운영과 같은 이름 api는 거부해요)
LOCAL_DB_PASSWORD=                   # 비우면 infra/.env의 API_DB_PASSWORD
LOCAL_JWT_SECRET=                    # 비우면 api 기본값(local-dev-only-…)
