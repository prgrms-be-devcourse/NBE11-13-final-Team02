# 복사해서 쓰세요: cp infra/.env.example infra/.env (.env는 git에 올리지 않아요). make infra가 없으면 자동으로 복사해요
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-pass
API_DB_PASSWORD=api-pass
COLLECTOR_DB_PASSWORD=collector-pass
EXTRACTION_DB_PASSWORD=extraction-pass

RABBITMQ_USER=mujuthaek
RABBITMQ_PASSWORD=mq-pass

# 원본 파일 저장소 (로컬 MinIO). collector의 기본값(S3_ENDPOINT=http://localhost:9000, minio / minio-pass)과 같아요
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-pass
S3_BUCKET=mujuthaek-raw

# 정책 API 인증키 (collector). 비우면 그 출처는 수집하지 않고 FAILED로 남아요
# 공공데이터포털: 보조금24(15113968)·중앙부처복지(15090532)·지자체복지(15108347)를 각각 활용신청해요
DATA_GO_KR_SERVICE_KEY=
# 온통청년: youthcenter.go.kr 마이페이지에서 발급
YOUTHCENTER_API_KEY=
# K-Startup(창업진흥원_K-Startup 조회서비스)은 공공데이터포털 키(DATA_GO_KR_SERVICE_KEY)를 같이 써요. 활용신청만 따로 해요
# 기업마당: bizinfo.go.kr 정책정보 개방 API에서 발급
BIZINFO_API_KEY=

# extraction 모델. 로컬 AI(LOCAL_AI_URL)를 먼저 쓰고, 안 되면 유료 OpenAI API를 써요
# LOCAL_AI_URL을 비우면 OpenAI API를 바로 쓰고, OPENAI_API_KEY를 비우면 로컬 AI만 써요(둘 다 없으면 추출 실패로 남아요)
LOCAL_AI_URL=
OPENAI_API_KEY=

# LH 수집기: 공공데이터포털 인증키 (LH 분양임대공고문·상세정보·공급정보, 마이홈 모집공고 API 활용신청). 포털에 보이는 키를 그대로 (인코딩된 값도 돼요). 비우면 LH 수집만 멈춰요
LH_API_KEY=

# api 카카오 로그인: developers.kakao.com > 내 애플리케이션 > 앱 키의 REST API 키, 카카오 로그인 > 보안의 Client Secret
# Redirect URI는 http://localhost:8080/login/oauth2/code/kakao 를 등록해요. 비우면 로그인만 동작하지 않아요
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# api 네이버 로그인: developers.naver.com > Application > 네이버 로그인, 제공 정보는 '별명'만.
# Callback URL은 http://localhost:8080/login/oauth2/code/naver. 개발 중에는 '멤버 관리'에 등록한 아이디만 로그인돼요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# api 구글 로그인: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션).
# 승인된 리디렉션 URI는 http://localhost:8080/login/oauth2/code/google. 테스트 중에는 동의 화면의 '테스트 사용자'만 로그인돼요
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로그인 뒤 돌아갈 프론트 주소 (CORS 허용 주소)
FRONTEND_URL=http://localhost:3000
# access token(JWT) 서명 키. 32바이트 이상 무작위 값 (예: openssl rand -base64 48). 운영은 필수.
# 로컬은 이 줄을 주석으로 두면 기본값을 써요 (빈 값 'JWT_SECRET='으로 두면 서버가 뜨지 않아요)
# JWT_SECRET=
