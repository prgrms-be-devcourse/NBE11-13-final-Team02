# 복사해서 쓰세요: cp infra/.env.example infra/.env (.env는 git에 올리지 않아요). make infra가 없으면 자동으로 복사해요
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-pass
API_DB_PASSWORD=api-pass
COLLECTOR_DB_PASSWORD=collector-pass
EXTRACTION_DB_PASSWORD=extraction-pass
NOTIFICATION_DB_PASSWORD=notification-pass

RABBITMQ_USER=mujuthaek
RABBITMQ_PASSWORD=mq-pass

# 원본 파일 저장소 (로컬 MinIO). collector의 기본값(S3_ENDPOINT=http://localhost:9000, minio / minio-pass)과 같아요
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-pass
S3_BUCKET=mujuthaek-raw

# 정책 API 인증키 (collector). 비우면 그 출처는 수집하지 않고 FAILED로 남아요
# 공공데이터포털: 보조금24(15113968)·중앙부처복지(15090532)·지자체복지(15108347)를 각각 활용신청해요
DATA_GO_KR_SERVICE_KEY=
# 온통청년: youthcenter.go.kr 마이페이지에서 발급
YOUTHCENTER_API_KEY=
# K-Startup(창업진흥원_K-Startup 조회서비스)은 공공데이터포털 키(DATA_GO_KR_SERVICE_KEY)를 같이 써요. 활용신청만 따로 해요
# 기업마당: bizinfo.go.kr 정책정보 개방 API에서 발급
BIZINFO_API_KEY=

# extraction 모델. 로컬 AI(LOCAL_AI_URL)를 먼저 쓰고, 안 되면 유료 OpenAI API를 써요
# LOCAL_AI_URL을 비우면 OpenAI API를 바로 쓰고, OPENAI_API_KEY를 비우면 로컬 AI만 써요(둘 다 없으면 추출 실패로 남아요)
LOCAL_AI_URL=
OPENAI_API_KEY=

# LH 수집기: 공공데이터포털 인증키 (LH 분양임대공고문·상세정보·공급정보, 마이홈 모집공고 API 활용신청). 포털에 보이는 키를 그대로 (인코딩된 값도 돼요). 비우면 LH 수집만 멈춰요
LH_API_KEY=
