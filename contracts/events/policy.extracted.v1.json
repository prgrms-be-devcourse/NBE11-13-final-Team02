{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/events/policy.extracted.v1.json",
  "title": "policy.extracted v1",
  "description": "extraction이 정책(raw.policy.collected) 한 건을 추출한 뒤 보내요. api benefit 모듈이 받아 benefits·benefit_supports·benefit_conditions로 저장해요. 설계: contracts/schemas/policy-extracted.draft.md, 조건 모양: contracts/schemas/benefit-condition-types.draft.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "UUID v7. 받는 쪽은 processed_events로 한 번만 처리해요" },
    "eventType": { "const": "policy.extracted" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "extraction" },
    "traceId": { "type": ["string", "null"] },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableDate": { "type": ["string", "null"], "format": "date" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawPolicyId", "version", "sourceCode", "provider", "policyId", "field", "reprocess", "source", "relevant", "relevanceReason",
        "summary", "supports", "schedule", "howToApply", "documents", "contact", "conditions", "quality"
      ],
      "properties": {
        "rawPolicyId": { "type": "string", "format": "uuid", "description": "수집 DB 정책 ID (raw.policy.collected 그대로). benefits를 찾는 키" },
        "version": { "type": "integer", "minimum": 1, "description": "수집 버전. 받는 쪽은 저장된 버전보다 작거나 같으면 버려요" },
        "sourceCode": { "enum": ["gov24", "bokjiro_central", "bokjiro_local", "youth", "kstartup", "bizinfo"] },
        "provider": { "enum": ["GOV24", "BOKJIRO", "YOUTHCENTER", "KSTARTUP", "BIZINFO"] },
        "policyId": { "type": "string", "minLength": 1, "description": "출처의 정책 ID" },
        "field": { "enum": ["BENEFIT", "STARTUP_SUPPORT"], "description": "BENEFIT 주거·이주 혜택, STARTUP_SUPPORT 창업 지원" },
        "reprocess": { "type": "boolean", "description": "true면 사용자 알림을 보내지 않아요" },
        "source": { "$ref": "#/$defs/source" },
        "relevant": { "type": "boolean", "description": "서비스 범위(이주 혜택, 창업 공간·자금)에 맞는지. false면 benefit은 숨겨요" },
        "relevanceReason": { "$ref": "#/$defs/nullableString", "description": "범위 판단 이유 한 문장" },
        "summary": { "type": ["string", "null"], "maxLength": 200, "description": "화면 한 줄 요약 (80자 안을 권장)" },
        "supports": { "type": "array", "items": { "$ref": "#/$defs/support" } },
        "schedule": { "$ref": "#/$defs/schedule" },
        "howToApply": { "$ref": "#/$defs/nullableString" },
        "documents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "contact": { "$ref": "#/$defs/nullableString" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "quality": { "$ref": "#/$defs/quality" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "agency", "regionScope", "regionNames", "regionCodes", "categories", "detailUrl", "applyUrl"],
      "description": "수집기가 통일한 기본 칸 (raw.policy.collected 그대로)",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "agency": { "$ref": "#/$defs/nullableString" },
        "regionScope": { "enum": ["NATIONWIDE", "SIDO", "SIGUNGU", "UNKNOWN"] },
        "regionNames": { "type": "array", "items": { "type": "string" } },
        "regionCodes": { "type": "array", "items": { "type": "string", "pattern": "^([0-9]{2}|[0-9]{5})$" }, "description": "시도 2자리 / 시군구 5자리. 수집 때 이름만 있었으면 extraction이 코드로 채워요" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "detailUrl": { "$ref": "#/$defs/nullableString" },
        "applyUrl": { "$ref": "#/$defs/nullableString" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amountMax", "amountPer", "months", "ratePct", "rawText", "evidence"],
      "properties": {
        "kind": { "enum": ["RENT", "DEPOSIT_LOAN", "PURCHASE_LOAN", "HOUSING_SUPPLY", "MOVE_IN_GRANT", "GRANT", "LOAN", "SPACE", "CASH", "OTHER"] },
        "amountMax": { "type": ["integer", "null"], "minimum": 0, "description": "최대 금액 (만 원). 없거나 못 읽으면 null" },
        "amountPer": { "enum": ["ONCE", "MONTH", "YEAR", null] },
        "months": { "type": ["integer", "null"], "minimum": 1, "description": "지원 기간 (개월)" },
        "ratePct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "지원 비율 (%)" },
        "rawText": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1, "description": "원문이 들어 있는 문장 (원문 text에 그대로)" }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applyStart", "applyEnd", "applyAlways", "businessStart", "businessEnd", "rawText"],
      "properties": {
        "applyStart": { "$ref": "#/$defs/nullableDate" },
        "applyEnd": { "$ref": "#/$defs/nullableDate" },
        "applyAlways": { "type": "boolean", "description": "상시 모집 (예산 소진 시까지 등)" },
        "businessStart": { "$ref": "#/$defs/nullableDate" },
        "businessEnd": { "$ref": "#/$defs/nullableDate" },
        "rawText": { "$ref": "#/$defs/nullableString" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value", "group", "known", "rawText", "evidence", "confidence", "origin"],
      "description": "자격 조건 한 줄 (benefit-condition-types.draft.md 1장 + origin). 같은 group은 또는, 다른 group은 그리고",
      "properties": {
        "type": {
          "enum": [
            "AGE", "MARITAL", "NEWLYWED_YEARS", "CHILDREN", "PREGNANCY", "HOUSEHOLD_TYPE", "WELFARE_STATUS", "SPECIAL_STATUS",
            "INCOME_MEDIAN_PCT", "INCOME_AMOUNT", "ASSET_AMOUNT",
            "RESIDENCE", "RESIDENCE_MONTHS", "MOVE_IN", "HOMELESS", "HOMELESS_YEARS", "LEASE", "FIRST_HOME",
            "EMPLOYMENT", "EDUCATION", "OCCUPATION", "WORKPLACE",
            "STARTUP_STAGE", "BUSINESS_YEARS", "INDUSTRY", "REVENUE", "EMPLOYEES", "BUSINESS_LOCATION",
            "EXCLUSIVE", "PRIORITY", "OTHER"
          ]
        },
        "value": { "type": ["object", "null"], "description": "type마다 정해진 모양. known=false면 null" },
        "group": { "type": "integer", "minimum": 1 },
        "known": { "type": "boolean" },
        "rawText": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "origin": { "enum": ["RULE", "AI"] }
      },
      "allOf": [
        { "if": { "properties": { "known": { "const": false } } }, "then": { "properties": { "value": { "type": "null" } } } }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "needsReview", "reviewReasons", "hasDocument", "documentStatus", "model", "promptVersion", "extractedAt"],
      "properties": {
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "needsReview": { "type": "boolean" },
        "reviewReasons": {
          "type": "array",
          "items": { "enum": ["EVIDENCE_NOT_FOUND", "LOW_CONFIDENCE", "NO_DOCUMENT", "RULE_AI_CONFLICT", "TEXT_TRUNCATED"] }
        },
        "hasDocument": { "type": "boolean" },
        "documentStatus": { "enum": ["OK", "NONE", "NO_SOURCE", "BLOCKED", "FAILED", "NOT_NEEDED"] },
        "model": { "$ref": "#/$defs/nullableString" },
        "promptVersion": { "$ref": "#/$defs/nullableString" },
        "extractedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
