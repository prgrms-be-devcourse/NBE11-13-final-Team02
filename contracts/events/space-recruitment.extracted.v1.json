{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/events/space-recruitment.extracted.v1.json",
  "title": "space-recruitment.extracted v1",
  "description": "extraction이 사업공간 모집 공고(raw.policy.collected 중 field = SPACE_RECRUITMENT)를 AI·규칙으로 추출하고 검증한 뒤 보내요. 입력 한 건마다 한 건. api benefit 모듈이 받아 space_recruitments(+ units, conditions)에 저장해요. 지원 정책(BENEFIT·STARTUP_SUPPORT)은 이 이벤트로 오지 않아요. 설명: contracts/schemas/space-recruitment-extracted.draft.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "UUID v7. 받는 쪽은 processed_events로 한 번만 처리해요" },
    "eventType": { "const": "space-recruitment.extracted" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "extraction" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableDate": { "type": ["string", "null"], "format": "date", "description": "YYYY-MM-DD. 모르면 null" },
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "nullableWon": { "type": ["integer", "null"], "minimum": 0, "description": "원 단위 금액. 글에 없거나 못 읽으면 null" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawPolicyId", "version", "sourceCode", "provider", "policyId", "reprocess", "source", "relevant", "relevanceReason", "summary",
        "facility", "units", "recruitCount", "residency", "hqRelocation", "schedule", "selectionMethod", "support", "howToApply", "documents", "contact",
        "conditions", "quality"
      ],
      "properties": {
        "rawPolicyId": { "type": "string", "format": "uuid", "description": "수집 DB raw_policies.id (raw.policy.collected 그대로). space_recruitments를 찾는 키" },
        "version": { "type": "integer", "minimum": 1, "description": "수집 버전 (그대로). 받는 쪽은 저장된 버전보다 작거나 같으면 버려요" },
        "sourceCode": { "enum": ["kstartup", "bizinfo", "youth"], "description": "출처 code (그대로). 사업공간 모집은 창업지원 출처에서만 나와요" },
        "provider": { "enum": ["KSTARTUP", "BIZINFO", "YOUTHCENTER"], "description": "API 제공처 (그대로)" },
        "policyId": { "type": "string", "minLength": 1, "description": "출처의 공고 ID (그대로)" },
        "reprocess": { "type": "boolean", "description": "그대로. true면 사용자 알림을 보내지 않아요" },
        "source": { "$ref": "#/$defs/source" },
        "relevant": { "type": "boolean", "description": "정말 공간을 빌려주는 모집 공고인지. 수집기는 이름으로만 나눠서 틀릴 수 있어요 ('입주기업 대상 마케팅 지원 모집'). false면 benefit은 숨겨요(HIDDEN). false여도 다른 칸은 채워서 보내요" },
        "relevanceReason": { "type": "string", "minLength": 1, "description": "relevant 판단 이유 한 문장" },
        "summary": { "$ref": "#/$defs/nullableString", "maxLength": 80, "description": "화면에 보일 한 줄 요약 (80자 안)" },
        "facility": { "$ref": "#/$defs/facility" },
        "units": { "type": "array", "items": { "$ref": "#/$defs/unit" }, "description": "모집하는 공간. 종류·크기·임대료가 다르면 줄을 나눠요. 글에 공간 정보가 없으면 빈 목록" },
        "recruitCount": { "$ref": "#/$defs/nullableCount", "description": "모집 기업·팀 수 ('10개사 내외'면 10)" },
        "residency": { "$ref": "#/$defs/residency" },
        "hqRelocation": { "$ref": "#/$defs/hqRelocation" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "selectionMethod": { "$ref": "#/$defs/nullableString", "description": "선정 방법 요약 (서류 평가 → 발표 평가 등)" },
        "support": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "입주하면 함께 받는 지원 (멘토링, 투자 연계, 장비 사용 …). 없으면 빈 목록" },
        "howToApply": { "$ref": "#/$defs/nullableString", "description": "신청 방법 요약" },
        "documents": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "제출 서류 이름" },
        "contact": { "$ref": "#/$defs/nullableString", "description": "문의처" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "description": "입주 자격. 줄이 없으면 제한 없음" },
        "quality": { "$ref": "#/$defs/quality" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "수집기가 통일한 기본 칸. raw.policy.collected 값을 그대로 옮기고, regionCodes만 비어 있으면 extraction이 지역 이름을 코드로 바꿔 채워요",
      "required": ["title", "agency", "regionScope", "regionNames", "regionCodes", "categories", "detailUrl", "applyUrl"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "agency": { "$ref": "#/$defs/nullableString" },
        "regionScope": { "enum": ["NATIONWIDE", "SIDO", "SIGUNGU", "UNKNOWN"] },
        "regionNames": { "type": "array", "items": { "type": "string" } },
        "regionCodes": { "type": "array", "items": { "type": "string", "pattern": "^([0-9]{2}|[0-9]{5})$" }, "description": "시도 2자리 / 시군구 5자리" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "detailUrl": { "$ref": "#/$defs/nullableString" },
        "applyUrl": { "$ref": "#/$defs/nullableString" }
      }
    },
    "facility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "address", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString", "description": "시설 이름 ('서울창업센터 동작')" },
        "kind": {
          "enum": ["INCUBATOR", "SHARED_OFFICE", "OFFICE", "FACTORY", "OTHER"],
          "description": "INCUBATOR 창업보육센터·창업센터, SHARED_OFFICE 공유오피스, OFFICE 사무실·업무시설, FACTORY 공장·제조공간, OTHER 그 밖. 상가·점포·청년몰 모집은 수집하지 않아요 (2026-10-22)"
        },
        "address": { "$ref": "#/$defs/nullableString", "description": "주소 원문" },
        "evidence": { "$ref": "#/$defs/nullableString", "description": "시설 이름·주소가 들어 있는 원문 문장 (text에 그대로 있어야 해요). 글에 시설 정보가 없으면 null" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "count", "areaM2", "seats", "deposit", "monthlyRent", "maintenanceFee", "rawText", "evidence"],
      "properties": {
        "name": { "$ref": "#/$defs/nullableString", "description": "공간 이름 ('1인실', '4인실', 'A동 201호')" },
        "count": { "$ref": "#/$defs/nullableCount", "description": "호실·좌석 수" },
        "areaM2": { "type": ["number", "null"], "exclusiveMinimum": 0, "description": "전용 면적 (㎡). 평이면 ㎡로 바꿔요 (1평 = 3.3058㎡)" },
        "seats": { "$ref": "#/$defs/nullableCount", "description": "한 공간의 좌석·인원 수" },
        "deposit": { "$ref": "#/$defs/nullableWon", "description": "보증금 (원)" },
        "monthlyRent": { "$ref": "#/$defs/nullableWon", "description": "월 임대료 (원). 무상이면 0" },
        "maintenanceFee": { "$ref": "#/$defs/nullableWon", "description": "월 관리비 (원)" },
        "rawText": { "type": "string", "minLength": 1, "description": "원문" },
        "evidence": { "type": "string", "minLength": 1, "description": "원문이 들어 있는 문장 (text에 그대로 있어야 해요)" }
      }
    },
    "residency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["months", "extendableMonths", "moveInDate", "rawText"],
      "properties": {
        "months": { "$ref": "#/$defs/nullableCount", "description": "기본 입주 기간 (개월)" },
        "extendableMonths": { "$ref": "#/$defs/nullableCount", "description": "연장까지 포함한 최대 기간 (개월)" },
        "moveInDate": { "$ref": "#/$defs/nullableDate", "description": "입주 예정일" },
        "rawText": { "$ref": "#/$defs/nullableString", "description": "입주 기간 원문" }
      }
    },
    "hqRelocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "입주 후 본점·사업장 주소를 시설로 옮겨야 하는 의무 ('입주 확정 시 3개월 이내 본점 소재지 이전'). 입주 자격(conditions)이 아니라 입주 후 지킬 일이라 판정하지 않아요 (2026-10-22 추가)",
      "required": ["mandatory", "withinMonths", "rawText", "evidence"],
      "properties": {
        "mandatory": { "type": ["boolean", "null"], "description": "true 이전 필수, false 이전하지 않아도 됨이 글에 있음, null 글에 없음" },
        "withinMonths": { "$ref": "#/$defs/nullableCount", "description": "이전 기한 (입주·계약 후 개월). '1개월 내'면 1, 기한이 없으면 null" },
        "rawText": { "$ref": "#/$defs/nullableString", "description": "본점 이전 원문" },
        "evidence": { "$ref": "#/$defs/nullableString", "description": "원문이 들어 있는 문장 (text에 그대로 있어야 해요)" }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applyStart", "applyEnd", "applyAlways", "rawText"],
      "properties": {
        "applyStart": { "$ref": "#/$defs/nullableDate", "description": "신청 시작일" },
        "applyEnd": { "$ref": "#/$defs/nullableDate", "description": "신청 마감일" },
        "applyAlways": { "type": "boolean", "description": "상시 모집 ('공실 발생 시 수시 모집' 등)" },
        "rawText": { "$ref": "#/$defs/nullableString", "description": "기간 원문. 출처에 날짜 칸이 있으면 규칙으로 바꿔요 (K-Startup pbanc_rcpt_*_dt, 기업마당 reqstBeginEndDe, 온통청년 aplyYmd)" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "description": "조건 한 줄. 모양과 type별 value는 contracts/schemas/benefit-condition-types.draft.md 1장·3장. 같은 group은 '또는', 다른 group은 '그리고'",
      "required": ["type", "value", "group", "known", "rawText", "evidence", "confidence", "origin"],
      "properties": {
        "type": {
          "enum": [
            "AGE", "MARITAL", "NEWLYWED_YEARS", "CHILDREN", "PREGNANCY", "HOUSEHOLD_TYPE", "WELFARE_STATUS", "SPECIAL_STATUS",
            "INCOME_MEDIAN_PCT", "INCOME_AMOUNT", "ASSET_AMOUNT", "RESIDENCE", "RESIDENCE_MONTHS", "MOVE_IN", "HOMELESS", "HOMELESS_YEARS",
            "LEASE", "FIRST_HOME", "EMPLOYMENT", "EDUCATION", "OCCUPATION", "WORKPLACE", "STARTUP_STAGE", "BUSINESS_YEARS", "INDUSTRY",
            "REVENUE", "EMPLOYEES", "BUSINESS_LOCATION", "EXCLUSIVE", "PRIORITY", "OTHER"
          ],
          "description": "사업공간 모집에서 주로 나오는 type: STARTUP_STAGE(예비·창업 후), BUSINESS_YEARS(업력), INDUSTRY(업종), BUSINESS_LOCATION(신청할 때의 사업장 소재지. 입주 후 본점 이전 의무는 hqRelocation), AGE(대표자 나이), EXCLUSIVE(제외 대상), PRIORITY(우대)"
        },
        "value": { "type": ["object", "null"], "description": "type마다 정해진 모양 ({\"max\":7} 등). known=false면 null" },
        "group": { "type": "integer", "minimum": 1 },
        "known": { "type": "boolean", "description": "값으로 바꿨는지. false면 판정은 UNKNOWN" },
        "rawText": { "type": "string", "minLength": 1, "description": "조건 원문 (화면의 판정 근거)" },
        "evidence": { "type": "string", "minLength": 1, "description": "원문이 들어 있는 문장 (text에 그대로 있어야 해요)" },
        "confidence": { "$ref": "#/$defs/confidence", "description": "규칙으로 옮긴 값은 1" },
        "origin": { "enum": ["RULE", "AI"], "description": "RULE 출처 코드 칸에서 규칙으로, AI 글에서. 같은 type이 둘 다에서 나오면 규칙 줄만 보내요" }
      },
      "if": { "properties": { "known": { "const": false } } },
      "then": { "properties": { "value": { "type": "null" } } }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "needsReview", "reviewReasons", "hasDocument", "documentStatus", "model", "promptVersion", "extractedAt"],
      "properties": {
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "공고 전체 신뢰도 0~1" },
        "needsReview": { "type": "boolean", "description": "사람 확인 필요 (evidence가 원문에 없음, confidence 0.6 미만, relevant 판단이 애매함)" },
        "reviewReasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["EVIDENCE_NOT_FOUND", "LOW_CONFIDENCE", "NO_DOCUMENT", "RULE_AI_CONFLICT", "TEXT_TRUNCATED"] }
        },
        "hasDocument": { "type": "boolean", "description": "raw.policy.collected 그대로" },
        "documentStatus": { "enum": ["OK", "NONE", "NO_SOURCE", "BLOCKED", "FAILED", "NOT_NEEDED"], "description": "raw.policy.collected 그대로" },
        "model": { "type": "string", "minLength": 1, "description": "추출에 쓴 모델 (다시 추출할 대상을 고를 때)" },
        "promptVersion": { "type": "string", "minLength": 1 },
        "extractedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
