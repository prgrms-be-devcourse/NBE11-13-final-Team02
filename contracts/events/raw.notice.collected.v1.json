{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/events/raw.notice.collected.v1.json",
  "title": "raw.notice.collected v1",
  "description": "collector가 기관 공고를 새로 저장(또는 새 버전으로 저장)했을 때 보내요. extraction이 받아서 AI 추출을 해요. 보내는 쪽: services/collector/src/mujuthaek_collector/core/publisher.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "producer", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid", "description": "UUID v7. 받는 쪽은 processed_events로 한 번만 처리해요" },
    "eventType": { "const": "raw.notice.collected" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "collector" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawPostId", "version", "sourceCode", "provider", "regionCode", "field", "kind", "title", "postedOn",
        "detailUrl", "supersedesPostId", "text", "textKey", "units", "files", "reprocess"
      ],
      "properties": {
        "rawPostId": { "type": "string", "format": "uuid", "description": "collector DB의 raw_posts.id. 같은 공고의 새 버전도 같은 값이에요" },
        "version": { "type": "integer", "minimum": 1, "description": "원본이 바뀔 때마다 1씩 늘어요" },
        "sourceCode": { "type": "string", "pattern": "^[a-z]+$", "description": "출처 code (sh, gh, bmc, ih, dcco, dudc, umca, gbdc, gndc …)" },
        "provider": { "type": "string", "minLength": 1, "description": "공급 기관 (SH, GH, BMC …)" },
        "regionCode": { "type": ["string", "null"], "pattern": "^[0-9]{5}$", "description": "시군구 코드 5자리. 수집 단계에서 모르면 null" },
        "field": { "enum": ["HOUSING"], "description": "이 이벤트는 주거 공고만 담아요" },
        "kind": { "enum": ["NOTICE", "CORRECTION", "FOLLOW_UP"] },
        "title": { "type": "string", "minLength": 1 },
        "postedOn": { "type": ["string", "null"], "format": "date" },
        "detailUrl": { "$ref": "#/$defs/nullableString", "description": "사람이 열어볼 기관 상세 주소" },
        "supersedesPostId": { "type": ["string", "null"], "format": "uuid", "description": "정정공고·후속 안내가 가리키는 원래 모집공고의 rawPostId" },
        "text": { "type": "string", "maxLength": 200000, "description": "AI 추출에 넘기는 전체 글자 (제목·게시 정보·항목·본문·공고문). 20만 자를 넘으면 앞부분만" },
        "textKey": { "$ref": "#/$defs/nullableString", "description": "text가 잘렸을 때만 채워지는 S3 위치 (text/<출처>/<글 키>/v<버전>.txt)" },
        "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "reprocess": { "type": "boolean", "description": "과거 공고 재처리면 true. true면 사용자 알림을 보내지 않아요" }
      }
    },
    "unit": {
      "type": "object",
      "description": "규칙으로 읽은 호별 임대조건. 값을 모르는 칸은 빠져요",
      "additionalProperties": false,
      "properties": {
        "page": { "type": "integer" },
        "complex": { "type": "string" },
        "district": { "type": "string" },
        "address": { "type": "string" },
        "unit": { "type": "string" },
        "floor": { "type": "string" },
        "houseType": { "type": "string" },
        "targetGroup": { "type": "string" },
        "rooms": { "type": "string" },
        "areaM2": { "type": "number", "description": "전용면적 (㎡)" },
        "depositWon": { "type": "integer", "description": "임대보증금 (원)" },
        "rentWon": { "type": "integer", "description": "월임대료 (원)" },
        "supplyCount": { "type": "integer" },
        "elevator": { "type": "string" },
        "parking": { "type": "string" },
        "sourceFile": { "type": "string", "description": "어느 파일(또는 '상세 화면')에서 읽었는지" },
        "checks": { "type": "array", "items": { "type": "string" }, "description": "말이 안 돼서 비운 값 (예: deposit_won=100)" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fileType", "role", "s3Key", "downloadUrl", "sha256"],
      "properties": {
        "name": { "type": "string", "description": "원래 파일 이름 (화면 표시용)" },
        "fileType": { "enum": ["pdf", "hwp", "hwpx", "xlsx", "xlsm", "xls"], "description": "파일 형식 (확장자)" },
        "role": { "enum": ["NOTICE_DOC", "UNIT_LIST"], "description": "NOTICE_DOC 공고문, UNIT_LIST 주택목록" },
        "s3Key": {
          "type": ["string", "null"],
          "pattern": "^raw/[a-z]+/",
          "description": "S3 버킷 안 경로 (주소 아님). 받는 서비스는 이 경로로 우리 S3에서 파일을 가져가요. 보관 기한이 지나 파일을 지운 뒤 재처리하면 null"
        },
        "downloadUrl": { "type": "string", "description": "기관 다운로드 주소 (사람에게 보여줄 링크용. extraction은 이 주소로 요청하지 않아요)" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
