{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/events/extraction.completed.v1.json",
  "title": "extraction.completed v1",
  "description": "AI 추출과 자동 검증이 끝났을 때 extraction이 보냅니다(팀 이벤트 흐름 문서 2026-10-15 확정 형식). 검수 중이어도 보내며 reviewStatus와 조건별 inReview로 표시합니다. 큐 mujuthaek.extraction.completed로 가고 api(notice)가 받습니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v7. 받는 쪽은 processed_events로 한 번만 처리합니다"
    },
    "eventType": {
      "const": "extraction.completed"
    },
    "schemaVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "const": "extraction"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ],
      "description": "여러 서비스를 거치는 작업을 묶는 ID. 공통 봉투 규격이며 지금은 비어 있습니다."
    },
    "payload": {
      "$ref": "https://mujuthaek.kr/contracts/events/extraction.completed.v1.json#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawPostId",
        "rawVersion",
        "field",
        "title",
        "conditions",
        "reviewStatus"
      ],
      "properties": {
        "rawPostId": {
          "type": "string",
          "format": "uuid",
          "description": "collector의 raw_posts.id. 창업지원(STARTUP_SUPPORT)은 raw.policy.collected의 rawPolicyId(판정 요청안 2026-10-22: 창업지원 판정 틀도 이 이벤트의 judgment로 보냄)"
        },
        "rawVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "raw.notice.collected의 version",
          "maximum": 2147483647
        },
        "field": {
          "enum": [
            "HOUSING",
            "BUSINESS_SPACE",
            "POLICY",
            "STARTUP_SUPPORT",
            "SPACE_RECRUITMENT"
          ],
          "description": "api는 HOUSING·BUSINESS_SPACE만 공고(notice)로 처리합니다. STARTUP_SUPPORT·SPACE_RECRUITMENT는 정책 수집(raw.policy.collected)에서 만든 판정 틀만 실어 오고 notice가 판정 목록용으로 따로 저장합니다(2026-10-22)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "https://mujuthaek.kr/contracts/events/extraction.completed.v1.json#/$defs/condition"
          },
          "description": "대상별 자격 조건 목록"
        },
        "reviewStatus": {
          "enum": [
            "AUTO_PASSED",
            "PARTIALLY_PASSED",
            "IN_REVIEW",
            "APPROVED"
          ],
          "description": "AUTO_PASSED: 자동 검증을 모두 통과(추출 결과 기준). 판정 틀(judgment) 안의 조건은 이와 별개로 조건마다 inReview를 따릅니다(AUTO_PASSED여도 inReview=true인 틀 조건은 판정에 쓰지 않고 확인 필요). IN_REVIEW: 검수 대기(조건별 inReview). APPROVED: 검수자가 확인·승인해 다시 보냄(같은 rawPostId·rawVersion의 이전 결과를 대체) PARTIALLY_PASSED: 공고는 게시하되 heldItems의 항목·섹션(조건은 inReview)만 확인 전까지 쓰지 않음(검수 대기열에 넣지 않음) 정책(STARTUP_SUPPORT·SPACE_RECRUITMENT, 2026-10-23): heldItems 없이 판정 틀 전체 기준으로 정합니다. AUTO_PASSED는 틀에 확인 필요(inReview) 조건이 없음, PARTIALLY_PASSED는 틀은 쓰되 일부 조건만 확인 필요(inReview 조건이 있거나 원문에 기준일이 없어 판정일을 기준일로 씀 — 판정은 inReview 조건을 확인 필요로), IN_REVIEW는 틀 전체를 믿을 수 없음(AI 틀이 검사에 걸려 구간 칸 규칙 틀을 썼거나 AI가 읽지 못함 — 받는 쪽은 이전 공개본을 유지하고 첫 버전이면 승인 전까지 공개하지 않음), APPROVED는 검수자가 승인해 다시 보낸 틀(공개본을 바꿈)"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "description": "공급 기관 (SH, LH …)"
        },
        "regionCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "description": "정책(STARTUP_SUPPORT·SPACE_RECRUITMENT)만: 시군구 5자리(xx000은 시도 전체). STARTUP_SUPPORT는 지원 지역(사업 대상 지역), SPACE_RECRUITMENT는 입주 공간이 있는 곳(검색·필터용)이며 신청자 거주지·사업장 소재지 요건은 판정 틀(judgment)의 REGION 조건으로만 나타냅니다. 빈 목록이면 전국(사업공간은 원문에서 공간 위치를 읽지 못했고 수집기 지역도 전국일 때). 지역을 정하지 못한 정책은 이벤트를 보내지 않습니다(사업공간은 원문에 적힌 공간 위치를 확인하지 못했는데 수집기 지역이 전국일 때도 — 한 곳에 있는 공간을 전국으로 내지 않음)"
        },
        "regionCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "지역 코드 5자리(법정동코드 앞 5자리 = 시도 2 + 시군구 3). 서비스는 시군구까지만 씁니다. 시군구 자리가 000이면 시도 단위(예: 11000 = 서울특별시, 시도 전체이거나 시군구를 모름)입니다. 상세 notice가 있으면 그 locations로 정해집니다: 모든 위치의 앞 5자리가 하나면 그 코드, 여러 시군구지만 같은 시도면 그 시도의 xx000, 여러 시도에 걸치거나 코드 없는 위치가 있거나 위치가 없으면 null"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "https://mujuthaek.kr/contracts/events/extraction.completed.v1.json#/$defs/schedule"
            },
            {
              "type": "null"
            }
          ],
          "description": "검증을 통과한 공고 전체 접수 일정만. 확실하지 않으면 null"
        },
        "applicationWindows": {
          "type": "array",
          "items": {
            "$ref": "https://mujuthaek.kr/contracts/events/extraction.completed.v1.json#/$defs/applicationWindow"
          },
          "description": "검증된 APPLICATION 일정의 순위·대상별 접수 구간입니다. 날짜 미정 구간도 null/null로 보존하며, 보류·자동 검수 이슈 범위는 제외합니다. 승인본은 사람이 확인한 이슈를 보존하고 사용합니다."
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "reprocess": {
          "type": "boolean",
          "description": "과거 공고 재처리면 true. 사용자 알림을 보내지 않습니다"
        },
        "notice": {
          "$ref": "https://mujuthaek.kr/contracts/schemas/extracted-notice.v1.json",
          "description": "상세 화면용 표준 공고 전체(가격·공급·단지·근거·검증 결과). AUTO_PASSED·PARTIALLY_PASSED·APPROVED면 반드시 넣고, IN_REVIEW는 상세가 계약을 통과하지 못했을 때 뺄 수 있습니다"
        },
        "heldItems": {
          "type": "array",
          "items": {
            "$ref": "https://mujuthaek.kr/contracts/schemas/notice-common.v1.json#/$defs/heldItem"
          },
          "description": "부분 완료로 보류한 항목·섹션(notice.quality.heldItems와 같음). 공고 정체성(/notice 전체·제목·기관·분야)·입력·원본 문서·원문 출처·근거·검증 기록과 문서 전체(/)는 보류할 수 없습니다. notice가 없어도 이 목록으로 보류 규칙을 검사합니다 공고일·공급 유형·설명·대상 계층·공고 전체 수량은 칸 단위로 보류할 수 있고(예: /notice/announcedOn), 받는 쪽은 그 칸을 목록·중복 판단·알림에 쓰지 않습니다."
        },
        "detailUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "정책(STARTUP_SUPPORT·SPACE_RECRUITMENT)만, 반드시 넣음(공고 분야에는 넣지 않음): 사람이 열어볼 정책 원문 주소(raw.policy.collected의 detailUrl). http(s) 주소가 아니거나 인증 값·사용자 정보가 든 주소(PRIVATE_URL)면 null. 판정 목록에서 공고 상세 API로 찾을 수 없는 정책을 이 주소로 보냅니다"
        },
        "applyAlways": {
          "type": "boolean",
          "description": "정책(STARTUP_SUPPORT·SPACE_RECRUITMENT)만, 반드시 넣음(공고 분야에는 넣지 않음): 상시 모집이면 true. 출처가 칸으로 분명히 알려 준 경우만(온통청년 신청 기간 구분 상시, 신청 기간 칸 글자 전체가 상시·수시·연중 모집). 모르면 false. 받는 쪽은 마감일(schedule.applyEndOn)이 없고 applyAlways도 false인 정책을 마감일 모름으로 보고 열린 목록에 넣지 않습니다"
        },
        "applyNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50,
          "description": "정책(STARTUP_SUPPORT·SPACE_RECRUITMENT)만, 없거나 null이어도 됨: 마감일 대신 쓰는 신청 기간 안내. 출처의 신청 기간 칸 글자 전체가 「예산 소진 시까지」류일 때만 「예산 소진 시까지」. 날짜가 있거나 상시 모집이면 null. 받는 쪽은 마감일이 없어도 이 값이 있으면 열린 사업으로 보고 이 글을 보여 줍니다"
        },
        "policyInfo": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "정책(STARTUP_SUPPORT·SPACE_RECRUITMENT)만, 넣지 않거나 null이어도 됨: 출처 API 칸을 그대로 옮긴 안내(AI가 만든 값이 아님). 판정 틀에 없는 지원 분야·요약·문의처·접수 방법을 화면에 보여 주려고 씁니다. 모르는 칸은 null",
          "properties": {
            "supportArea": {
              "type": [
                "string",
                "null"
              ],
              "description": "출처가 붙인 지원 분야 (K-Startup supt_biz_clsfc 예: 사업화 · 융자 · 시설ㆍ공간ㆍ보육, 기업마당 지원분야 중분류 예: 창업공간지원)"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ],
              "description": "공고 요약 (K-Startup pbanc_ctnt, 기업마당 bsnsSumryCn에서 태그를 뺀 글)"
            },
            "organization": {
              "type": [
                "string",
                "null"
              ],
              "description": "공고·운영 기관 이름"
            },
            "contact": {
              "type": [
                "string",
                "null"
              ],
              "description": "문의처 (전화·부서)"
            },
            "applyMethod": {
              "type": [
                "string",
                "null"
              ],
              "description": "접수 방법 (온라인·이메일·방문 등, 출처 칸 글자)"
            },
            "applyUrl": {
              "type": [
                "string",
                "null"
              ],
              "description": "신청 주소 (http(s)만)"
            },
            "guideUrl": {
              "type": [
                "string",
                "null"
              ],
              "description": "사업 안내 주소 (http(s)만)"
            },
            "amountText": {
              "type": [
                "string",
                "null"
              ],
              "description": "요약 글에 「최대 · 최고 · 한도 N원」이 있으면 그 구절. 없으면 null"
            }
          }
        },
        "judgment": {
          "anyOf": [
            {
              "$ref": "https://mujuthaek.kr/contracts/schemas/housing-judgment.v1.json"
            },
            {
              "$ref": "https://mujuthaek.kr/contracts/schemas/business-space-judgment.v1.json"
            },
            {
              "$ref": "https://mujuthaek.kr/contracts/schemas/startup-support-judgment.v1.json"
            },
            {
              "type": "null"
            }
          ],
          "description": "판정 틀(판정 담당이 정한 형식 그대로). HOUSING이면 housing-judgment.v1, BUSINESS_SPACE면 business-space-judgment.v1, STARTUP_SUPPORT면 startup-support-judgment.v1(rawPolicyId·rawVersion이 이 이벤트의 rawPostId·rawVersion과 같음, 수집 이벤트 raw.policy.collected에서 만들어 notice 없음). 틀이 없는 분야이거나 틀 검사를 통과하지 못하면 null 또는 칸 없음. 추출 결과(notice·conditions)에서 코드로 만들며, 확신이 없는 조건은 틀의 inReview로 표시합니다."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "const": "AUTO_PASSED"
              }
            },
            "required": [
              "reviewStatus"
            ]
          },
          "then": {
            "properties": {
              "conditions": {
                "items": {
                  "properties": {
                    "inReview": {
                      "const": false
                    }
                  }
                }
              },
              "notice": {
                "properties": {
                  "quality": {
                    "properties": {
                      "verification": {
                        "properties": {
                          "status": {
                            "const": "PASSED"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "const": "APPROVED"
              }
            },
            "required": [
              "reviewStatus"
            ]
          },
          "then": {
            "properties": {
              "conditions": {
                "items": {
                  "properties": {
                    "inReview": {
                      "const": false
                    }
                  }
                }
              },
              "heldItems": {
                "maxItems": 0
              },
              "notice": {
                "properties": {
                  "quality": {
                    "properties": {
                      "heldItems": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "const": "PARTIALLY_PASSED"
              },
              "field": {
                "not": {
                  "enum": [
                    "STARTUP_SUPPORT",
                    "SPACE_RECRUITMENT"
                  ]
                }
              }
            },
            "required": [
              "reviewStatus",
              "field"
            ]
          },
          "then": {
            "required": [
              "heldItems"
            ],
            "properties": {
              "heldItems": {
                "minItems": 1
              },
              "notice": {
                "properties": {
                  "quality": {
                    "properties": {
                      "verification": {
                        "properties": {
                          "status": {
                            "const": "PARTIALLY_PASSED"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reviewStatus": {
                "enum": [
                  "AUTO_PASSED",
                  "PARTIALLY_PASSED",
                  "APPROVED"
                ]
              },
              "field": {
                "enum": [
                  "HOUSING",
                  "BUSINESS_SPACE"
                ]
              }
            },
            "required": [
              "reviewStatus",
              "field"
            ]
          },
          "then": {
            "required": [
              "notice"
            ],
            "properties": {
              "notice": {
                "properties": {
                  "notice": {
                    "properties": {
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "publisher": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "supplyType": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "field": {
                        "enum": [
                          "HOUSING",
                          "BUSINESS_SPACE"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applyStartOn",
        "applyEndOn"
      ],
      "properties": {
        "applyStartOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "applyEndOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "applicationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduleId",
        "label",
        "applyStartOn",
        "applyEndOn",
        "priorityRank",
        "targetGroups",
        "scopeDescription"
      ],
      "properties": {
        "scheduleId": {
          "type": "string",
          "minLength": 1,
          "description": "notice.schedules[].id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "원문 일정 이름(rawLabel). 예: 1순위 인터넷 접수"
        },
        "applyStartOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "applyEndOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "priorityRank": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "targetGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scopeDescription": {
          "type": [
            "string",
            "null"
          ],
          "description": "적용 대상 설명(예: 만 65세 이상·장애인 현장 접수)"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "targetGroups",
        "category",
        "description",
        "originalText",
        "referenceTime",
        "rule",
        "exceptions",
        "inReview",
        "reviewReasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "notice.eligibility[].id와 같음"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "적용 대상 (원문 표현)"
        },
        "targetGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "category": {
          "$ref": "https://mujuthaek.kr/contracts/schemas/eligibility.v1.json#/$defs/eligibility/properties/category"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "존댓말 설명"
        },
        "originalText": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "원문 그대로"
        },
        "referenceTime": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "$ref": "https://mujuthaek.kr/contracts/schemas/eligibility.v1.json#/$defs/rule"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "https://mujuthaek.kr/contracts/schemas/eligibility.v1.json#/$defs/exception"
          }
        },
        "inReview": {
          "type": "boolean",
          "description": "검수 대기 중인 조건이면 true(reviewReasons 1개 이상). conditions[i]는 notice.eligibility[i]이며, 보류 대상(heldItems.target)이 /eligibility/i와 같거나 그 안(/eligibility/i/rule 등)이거나 그것을 품으면(/eligibility) 반드시 true"
        },
        "reviewReasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "검수 사유 코드"
        },
        "scope": {
          "$ref": "https://mujuthaek.kr/contracts/schemas/notice-common.v1.json#/$defs/scope",
          "description": "적용 단지·호별 범위. 새 발행본은 항상 포함합니다. 이전 v1에서 생략했으면 notice.eligibility의 같은 순번에서 복원합니다."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "inReview": {
                "const": false
              }
            },
            "required": [
              "inReview"
            ]
          },
          "then": {
            "properties": {
              "reviewReasons": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "inReview": {
                "const": true
              }
            },
            "required": [
              "inReview"
            ]
          },
          "then": {
            "properties": {
              "reviewReasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
