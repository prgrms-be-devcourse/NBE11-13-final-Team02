{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/schemas/startup-support-judgment.v1.json",
  "title": "창업지원 판정 틀 v1",
  "description": "창업지원 사업 공고의 추출 결과를 지원 자격 판정용으로 한 번 더 가공한 데이터. 모든 칸을 항상 넣고, 없으면 null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rawPolicyId",
    "rawVersion",
    "referenceDate",
    "common",
    "groups",
    "preferences",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "startup-support-judgment.v1"
    },
    "rawPolicyId": {
      "type": "string",
      "minLength": 1
    },
    "rawVersion": {
      "type": "integer",
      "minimum": 1
    },
    "referenceDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "판정 기준일 (보통 모집공고일). 공고에 기준일 문구가 없으면 null이고, 그러면 판정하는 날 기준이에요"
    },
    "common": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preference"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
