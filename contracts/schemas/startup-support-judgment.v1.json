        "inReview": {
          "type": "boolean",
          "description": "가공하면서 확신이 없으면 true. 판정은 이 조건을 계산하지 않고 '확인 필요'로 둬요"
        },
        "reviewReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "inReview가 true인 이유"
