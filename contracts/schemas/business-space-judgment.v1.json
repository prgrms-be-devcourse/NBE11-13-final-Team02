          "description": "근거 원문 (공고문에 있는 그대로)"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "근거 쪽 번호"
        },
        "inReview": {
          "type": "boolean",
          "description": "가공하면서 확신이 없으면 true. 판정은 이 조건을 계산하지 않고 '확인 필요'로 둬요"
        },
        "reviewReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "inReview가 true인 이유"
        },
        "minAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "minAge": {
                "type": "null"
