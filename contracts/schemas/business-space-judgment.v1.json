{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/schemas/business-space-judgment.v1.json",
  "title": "사업공간 판정 틀 v1",
  "description": "추출 결과를 사업공간(상가·점포) 입점 자격 판정용으로 한 번 더 가공한 데이터. 모든 칸을 항상 넣고, 없으면 null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rawPostId",
    "rawVersion",
    "referenceDate",
    "common",
    "groups",
    "preferences",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "business-space-judgment.v1"
    },
    "rawPostId": {
      "type": "string",
      "minLength": 1
    },
    "rawVersion": {
      "type": "integer",
      "minimum": 1
    },
    "referenceDate": {
      "type": "string",
      "format": "date"
    },
    "common": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preference"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "$defs": {
