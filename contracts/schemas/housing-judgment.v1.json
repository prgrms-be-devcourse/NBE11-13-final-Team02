{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mujuthaek.kr/contracts/schemas/housing-judgment.v1.json",
  "title": "주거 판정 틀 v1",
  "description": "추출 결과를 주거 자격 판정용으로 한 번 더 가공한 데이터. 모든 칸을 항상 넣고, 없으면 null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rawPostId",
    "rawVersion",
    "referenceDate",
    "common",
    "groups",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "housing-judgment.v1"
    },
    "rawPostId": {
      "type": "string",
      "minLength": 1
    },
    "rawVersion": {
      "type": "integer",
      "minimum": 1
    },
    "referenceDate": {
      "type": "string",
      "format": "date"
    },
    "common": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "$defs": {
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor",
        "min",
        "max",
        "since",
        "countRule"
      ],
      "properties": {
        "factor": {
          "enum": [
            "HOUSEHOLD_SIZE",
            "NEWBORN_CHILDREN",
            "CHILDREN",
            "DUAL_INCOME"
          ]
        },
        "min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "countRule": {
          "enum": [
            "MINORS_IF_ANY_SINCE",
            "BORN_SINCE_ONLY",
            null
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "factor": {
                "const": "NEWBORN_CHILDREN"
              }
            }
          },
          "then": {
            "properties": {
              "since": {
                "type": "string"
              },
              "countRule": {
                "enum": [
                  "MINORS_IF_ANY_SINCE",
                  "BORN_SINCE_ONLY"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "since": {
                "type": "null"
              },
              "countRule": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "factor": {
                "const": "DUAL_INCOME"
              }
            }
          },
          "then": {
            "properties": {
              "min": {
                "type": "null"
              },
              "max": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "bonus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "addPercent"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/factor"
        },
        "addPercent": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "maxWon"
      ],
      "properties": {
        "when": {
          "$ref": "#/$defs/factor"
        },
        "maxWon": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "printedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "householdSize",
        "maxWon"
      ],
      "properties": {
        "householdSize": {
          "type": "integer",
          "minimum": 1
        },
        "maxWon": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "age": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "quote",
        "page",
        "inReview",
        "reviewReason",
        "minAge",
        "maxAge"
      ],
      "properties": {
        "kind": {
          "const": "AGE"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "공고 안에서 유일한 ID. ASK 답도 이 ID로 받아요"
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "description": "근거 원문 (공고문에 있는 그대로)"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "근거 쪽 번호"
        },
        "inReview": {
          "type": "boolean",
          "description": "가공하면서 확신이 없으면 true. 판정은 이 조건을 계산하지 않고 '확인 필요'로 둬요"
        },
        "reviewReason": {
          "type": [
            "string",
            "null"
          ],
          "description": "inReview가 true인 이유"
        },
        "minAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "minAge": {
                "type": "null"
              },
              "maxAge": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
