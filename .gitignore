# IDE
.idea/
*.iml

# 자바
build/
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# 파이썬
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# 비밀 값 (키는 ~/.aws/credentials 에만 두고 저장소에는 넣지 않음)
.env
*.env
.env.*
!.env.example
*.pem
*.csv
# 공개 데이터로 만든 area 적재 테스트 자료는 올려요
!services/api/src/test/resources/area/fixtures/*.csv
!services/api/src/test/resources/area/geocode/*.csv
!services/collector/area/area_manifest.csv
!services/collector/area/area_manifest_address.csv
!services/collector/area/area_manifest_boundary.csv
# 법정동코드 테스트 자료 (저장소 원본에서 뗀 줄)
!services/api/src/test/resources/common/*.csv
.aws/
# 구조 변경 스크립트 백업
_backup_*/

# macOS
.DS_Store

# 개인 문서 (저장소에 올리지 않음)
.docs/

# area 비교 도구 결과 (커밋하지 않음)
tools/area-bench/results-*.txt

# Claude Code 로컬 작업 폴더
.claude/
